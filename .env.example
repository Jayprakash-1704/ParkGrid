# Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# MongoDB (optional — leaves blank to use automatic mongodb-memory-server fallback)
MONGODB_URI=""

# JWT Authentication
JWT_SECRET="parkgrid_dev_jwt_secret_change_in_production"
JWT_REFRESH_SECRET="parkgrid_dev_refresh_secret_change_in_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Cashfree Payment Gateway (optional — built-in verified sandbox runs when unset)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX"

# Cloudinary Image Uploads (optional — local fallback when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
