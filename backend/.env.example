PORT=5000
NODE_ENV=development
APP_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# MongoDB (leave blank to auto-start in-memory MongoDB with pre-seeded demo data)
MONGODB_URI=""

# JWT Authentication
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Cashfree Payment Gateway (optional — built-in verified sandbox runs when unset)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="SANDBOX"

# Cloudinary Image Uploads (optional — inline fallback runs when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
